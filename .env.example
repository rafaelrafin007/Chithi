DJANGO_SECRET_KEY=replace-this-with-a-secure-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-render-service.onrender.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-render-service.onrender.com,https://your-frontend-domain.com

# Leave DATABASE_URL unset for local SQLite development.
# Set this in production to your Supabase/Render PostgreSQL connection URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL_REQUIRE=True
DJANGO_DB_CONN_MAX_AGE=0
DJANGO_DB_CONN_HEALTH_CHECKS=False

# Leave unset locally to use the in-memory Channels layer.
# Set in production for cross-worker WebSocket message delivery.
REDIS_URL=rediss://default:password@host:port

# Leave these unset for local MEDIA_ROOT/MEDIA_URL storage.
# Set all three in production to store uploaded media on Cloudinary.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend local development origin for CORS is configured in settings.py.
